{
  "name": "web-to-apk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web to APK workspace with local ZIP preview and configuration editor",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check": "npm run typecheck && npm test",
    "dev": "vite --config frontend/vite.config.ts frontend",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts frontend",
    "preview": "vite preview --config frontend/vite.config.ts frontend"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  }
}
