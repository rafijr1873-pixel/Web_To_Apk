NODE_ENV=development
HOST=0.0.0.0
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=file:./var/platform.sqlite
STORAGE_ROOT=./var/storage
UPLOAD_MAX_BYTES=52428800
ARCHIVE_MAX_EXPANDED_BYTES=209715200
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_RATIO=100
BUILD_TIMEOUT_SECONDS=900
BUILD_CONCURRENCY=1
# Inject a 32-byte base64 encryption key through your secret manager at deployment.
# No default encryption key is provided. Never commit a real key.
SIGNING_MASTER_KEY=
# Select a tested, digest-pinned worker image during phase 4 qualification.
ANDROID_WORKER_IMAGE=
